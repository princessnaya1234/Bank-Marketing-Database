    {
      "cell_type": "code",
      "source": [
        "# Code cell — Inference pipeline\n",
        "# -------------------------------------------------------------\n",
        "# (Re)use the last-trained model from the loop above.\n",
        "# If you restarted the kernel, you can re-train quickly on full train\n",
        "# or load from a saved checkpoint (see a later cell for saving/loading).\n",
        "\n",
        "final_model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=2)\n",
        "final_trainer_args = TrainingArguments(\n",
        "    output_dir=\"runs/sbic_final\",\n",
        "    per_device_train_batch_size=16,\n",
        "    per_device_eval_batch_size=32,\n",
        "    learning_rate=2e-5,\n",
        "    num_train_epochs=2,\n",
        "    eval_strategy=\"epoch\",\n",
        "    save_strategy=\"no\",\n",
        "    report_to=\"none\"\n",
        ")\n",
        "final_trainer = Trainer(\n",
        "    model=final_model, args=final_trainer_args,\n",
        "    train_dataset=tokd[\"train\"], eval_dataset=tokd[\"validation\"],\n",
        "    tokenizer=tokenizer\n",
        ")\n",
        "final_trainer.train()\n",
        "\n",
        "pipe = TextClassificationPipeline(\n",
        "    model=final_model, tokenizer=tokenizer,\n",
        "    return_all_scores=True, device=device\n",
        ")\n",
        "\n",
        "def classify_text(text: str):\n",
        "    \"\"\"\n",
        "    Returns: (label, probs_dict)\n",
        "      label ∈ {'benign', 'harmful'}\n",
        "      probs_dict = {'benign': p0, 'harmful': p1}\n",
        "    \"\"\"\n",
        "    scores = pipe(text)[0]   # list of {'label': 'LABEL_0/1', 'score': float}\n",
        "    mapping = {'LABEL_0': 'benign', 'LABEL_1': 'harmful'}\n",
        "    probs = {mapping[s['label']]: float(s['score']) for s in scores}\n",
        "    label = max(probs, key=probs.get)\n",
        "    return label, probs\n"
